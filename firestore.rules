rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(circleId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds;
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Profiles: anyone signed in can see names/avatars (needed to show circle members);
    // only you can write yours.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 30;
      allow delete: if false;
    }

    // Invite code -> circle id. Can be looked up by exact code, never listed.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        getAfter(/databases/$(database)/documents/circles/$(request.resource.data.circleId)).data.ownerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/circles/$(request.resource.data.circleId)).data.inviteCode == code;
      allow delete: if signedIn() &&
        get(/databases/$(database)/documents/circles/$(resource.data.circleId)).data.ownerId == request.auth.uid;
      allow update: if false;
    }

    match /circles/{circleId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.memberIds == [request.auth.uid] &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 40;

      // Owner can rename, change the invite code, or remove members.
      // The owner must always remain a member.
      allow update: if signedIn() &&
        resource.data.ownerId == request.auth.uid &&
        onlyChanged(['name', 'inviteCode', 'memberIds']) &&
        request.auth.uid in request.resource.data.memberIds &&
        resource.data.memberIds.toSet().hasAll(request.resource.data.memberIds);

      // Joining: a non-member adds exactly themselves. The circle id is only
      // discoverable through an invite code, since circles can't be listed by non-members.
      allow update: if signedIn() &&
        onlyChanged(['memberIds']) &&
        !(request.auth.uid in resource.data.memberIds) &&
        request.resource.data.memberIds.toSet() ==
          resource.data.memberIds.toSet().union([request.auth.uid].toSet());

      // Leaving: a non-owner member removes exactly themselves.
      allow update: if signedIn() &&
        resource.data.ownerId != request.auth.uid &&
        onlyChanged(['memberIds']) &&
        request.auth.uid in resource.data.memberIds &&
        request.resource.data.memberIds.toSet() ==
          resource.data.memberIds.toSet().difference([request.auth.uid].toSet());

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /lists/{listId} {
        allow read, delete: if isMember(circleId);
        // getAfter so the first list can be created in the same batch as its circle.
        allow create, update: if signedIn() &&
          request.auth.uid in getAfter(/databases/$(database)/documents/circles/$(circleId)).data.memberIds &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 40;

        match /items/{itemId} {
          allow read, delete: if isMember(circleId);
          allow create: if isMember(circleId) &&
            request.resource.data.addedBy == request.auth.uid &&
            request.resource.data.name is string &&
            request.resource.data.name.size() > 0 &&
            request.resource.data.name.size() <= 80;
          allow update: if isMember(circleId) &&
            request.resource.data.addedBy == resource.data.addedBy &&
            request.resource.data.name is string &&
            request.resource.data.name.size() > 0 &&
            request.resource.data.name.size() <= 80;
        }
      }
    }
  }
}
